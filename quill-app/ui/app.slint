import { Button, Slider } from "std-widgets.slint";

export component AppWindow inherits Window {
    in property <image> texture <=> canvas.source;
    in-out property <int> active-tool: 0;
    in-out property <float> round-tip-radius: 2;
    in-out property <float> eraser-size: 12;
    in-out property <int> eraser-shape: 0;
    out property <length> requested-texture-width: canvas.width;
    out property <length> requested-texture-height: canvas.height;
    callback active-tool-changed(int);
    callback round-tip-radius-changed(float);
    callback eraser-size-changed(float);
    callback eraser-shape-changed(int);

    title: "Quill";
    preferred-width: 1280px;
    preferred-height: 840px;

    Rectangle {
        background: #f7f7ef;

        canvas := Image {
            width: 100%;
            height: 100%;
            image-fit: fill;
        }

        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 56px;
            background: #fffffff0;
            border-color: #d8d8cf;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: start;

                Button {
                    text: root.active-tool == 0 ? "Pen *" : "Pen";
                    clicked => {
                        root.active-tool = 0;
                        root.active-tool-changed(0);
                    }
                }

                Button {
                    text: root.active-tool == 1 ? "Eraser *" : "Eraser";
                    clicked => {
                        root.active-tool = 1;
                        root.active-tool-changed(1);
                    }
                }

                Text {
                    text: "Pen";
                    vertical-alignment: center;
                    color: #202020;
                    font-weight: 600;
                }

                Text {
                    text: "Radius";
                    vertical-alignment: center;
                    color: #505050;
                }

                Slider {
                    width: 220px;
                    minimum: 0.5;
                    maximum: 24;
                    step: 0.5;
                    value: root.round-tip-radius;
                    changed(value) => {
                        root.round-tip-radius = value;
                        root.round-tip-radius-changed(value);
                    }
                }

                Text {
                    text: Math.round(root.round-tip-radius * 10) / 10;
                    vertical-alignment: center;
                    color: #303030;
                }

                Text {
                    text: "Eraser";
                    vertical-alignment: center;
                    color: #202020;
                    font-weight: 600;
                }

                Button {
                    text: root.eraser-shape == 0 ? "Circle *" : "Circle";
                    clicked => {
                        root.eraser-shape = 0;
                        root.eraser-shape-changed(0);
                    }
                }

                Button {
                    text: root.eraser-shape == 1 ? "Square *" : "Square";
                    clicked => {
                        root.eraser-shape = 1;
                        root.eraser-shape-changed(1);
                    }
                }

                Text {
                    text: "Size";
                    vertical-alignment: center;
                    color: #505050;
                }

                Slider {
                    width: 180px;
                    minimum: 2;
                    maximum: 64;
                    step: 1;
                    value: root.eraser-size;
                    changed(value) => {
                        root.eraser-size = value;
                        root.eraser-size-changed(value);
                    }
                }

                Text {
                    text: Math.round(root.eraser-size);
                    vertical-alignment: center;
                    color: #303030;
                }
            }
        }
    }
}
